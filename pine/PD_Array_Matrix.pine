bool   dr5 = input.bool(true, "Draw", inline = "t5", group = G_TF)

const string G_DET = "Detection"
int    swingLen  = input.int(2, "Swing length (bars each side)", minval = 1, maxval = 10, group = G_DET)
int    atrLen    = input.int(14, "ATR length", minval = 1, group = G_DET)
float  eqTolAtr  = input.float(0.10, "Equal highs/lows tolerance (x ATR)", minval = 0, step = 0.05, group = G_DET, tooltip = "Swing highs/lows within this distance merge into one liquidity pool (touches++).")
float  rbWickPct = input.float(0.50, "Rejection block min wick (fraction of range)", minval = 0.1, maxval = 1, step = 0.05, group = G_DET)
float  fvgMinAtr = input.float(0.10, "FVG min size (x ATR)", minval = 0, step = 0.05, group = G_DET)
float  viMinAtr  = input.float(0.00, "Volume imbalance min size (x ATR)", minval = 0, step = 0.05, group = G_DET)
bool   viOverlap = input.bool(true, "Volume imbalance requires overlapping wicks", group = G_DET)
float  dispAtr   = input.float(1.00, "Displacement body (x ATR)", minval = 0, step = 0.1, group = G_DET, tooltip = "A bullish/bearish FVG whose middle candle body is at least this big also triggers an order block.")
int    obLookback = input.int(10, "Order block lookback (candles)", minval = 1, maxval = 30, group = G_DET)
string obZone    = input.string("Wick", "Order block zone", options = ["Wick", "Body"], group = G_DET)

const string G_LC = "Lifecycle"
int    maxAge   = input.int(200, "Expire after (TF candles)", minval = 5, group = G_LC)
int    maxLive  = input.int(30, "Max live arrays per TF", minval = 5, maxval = 60, group = G_LC)
int    keepDead = input.int(6, "Keep ended arrays per TF", minval = 0, maxval = 20, group = G_LC)

const string G_DR = "Chart drawing"
bool   drawOn    = input.bool(true, "Draw PD arrays", group = G_DR)
