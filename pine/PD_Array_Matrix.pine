//@version=6
//
// ICT PD Array Matrix — multi-timeframe lifecycle engine + "One Setup for Life" model
//
//   Premium (range high -> EQ)          Discount (EQ -> range low)
//     1 Liquidity Pool                    1 Mitigation Block
//     2 Rejection Block                   2 Breaker Block
//     3 Order Block                       3 Volume Imbalance
//     4 Fair Value Gap                    4 Fair Value Gap
//     5 Volume Imbalance                  5 Order Block
//     6 Breaker Block                     6 Rejection Block
//     7 Mitigation Block                  7 Liquidity Pool
//
// Every PD array on every timeframe runs the same lifecycle, evaluated on that timeframe's candle close:
//   Fresh -> Tested -> (Filled) -> Invalidated -> successor (FVG -> iFVG, OB -> Breaker / Mitigation Block)
//   Liquidity pools: Fresh -> Swept (wick through, close back) | Run (close through)
//   Anything live too long / beyond capacity -> Expired
//
// Rules: docs/RULES.md. Executable reference + tests: pdmatrix/ (Python).
indicator("ICT PD Array Matrix [MTF Lifecycle]", shorttitle = "PD Matrix", overlay = true, max_boxes_count = 500, max_lines_count = 100, max_labels_count = 100)

// ═══════════════════════════════════════════════════════════════════ constants
const int K_LP  = 0
const int K_RB  = 1
const int K_OB  = 2
const int K_FVG = 3
const int K_VI  = 4
const int K_BB  = 5
const int K_MB  = 6

const int S_FRESH   = 0
const int S_TESTED  = 1
const int S_FILLED  = 2
const int S_SWEPT   = 3
const int S_RUN     = 4
const int S_INVALID = 5
const int S_EXPIRED = 6

const int T_NONE    = 0
const int T_TESTED  = 1
const int T_FILLED  = 2
const int T_SWEPT   = 3
const int T_RUN     = 4
const int T_INVALID = 5
const int T_EXPIRED = 6

const int    MAXC  = 64   // candles kept per timeframe
const int    MAXSW = 20   // swings kept per side per timeframe
const string NY    = "America/New_York"

// ═══════════════════════════════════════════════════════════════════ inputs
const string G_TF  = "Timeframes (column · draw)"
bool   colChart = input.bool(true, "Chart TF", inline = "c0", group = G_TF)
bool   drChart  = input.bool(true, "Draw", inline = "c0", group = G_TF)
string tf1 = input.timeframe("15", "TF 1", inline = "t1", group = G_TF)
bool   on1 = input.bool(true, "", inline = "t1", group = G_TF)
bool   dr1 = input.bool(true, "Draw", inline = "t1", group = G_TF)
string tf2 = input.timeframe("60", "TF 2", inline = "t2", group = G_TF)
bool   on2 = input.bool(true, "", inline = "t2", group = G_TF)
bool   dr2 = input.bool(true, "Draw", inline = "t2", group = G_TF)
string tf3 = input.timeframe("240", "TF 3", inline = "t3", group = G_TF)
bool   on3 = input.bool(true, "", inline = "t3", group = G_TF)
bool   dr3 = input.bool(true, "Draw", inline = "t3", group = G_TF)
